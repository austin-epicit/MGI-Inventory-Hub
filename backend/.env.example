# Copy to .env (gitignored). One-time deploy config only; operating actions live in the UI.
NODE_ENV=development
PORT=3100
DATABASE_URL=postgresql://postgres@localhost:5440/mgi
# Tests only; migrated and truncated freely.
TEST_DATABASE_URL=postgresql://postgres@localhost:5440/mgi_test
# Signs session cookies, 16+ chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me
SESSION_TTL_HOURS=12
# AES-256-GCM key for the stored Cin7 credentials: exactly 32 bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=change-me
# Authorizes creating the first admin from the Setup page.
SETUP_TOKEN=change-me
# Fallback until the first sync reads the Cin7 time zone.
APP_TIMEZONE=America/Los_Angeles
# "fixture" serves generated data; "http" talks to Cin7 (or the fake Cin7 server).
CIN7_SOURCE=fixture
# With NODE_ENV=production the API refuses to start on CIN7_SOURCE=fixture unless this is "true"
# (a deliberate hosted demo). Only "true" or "false".
ALLOW_DEMO_DATA=false
CIN7_BASE_URL=https://inventory.dearsystems.com/ExternalApi/v2/
# Product pictures. Relative paths resolve from the backend folder (local dev); production: /data/uploads on the volume.
UPLOADS_DIR=./uploads
# The browser-visible origin; same-origin checks compare against its host. Cin7 webhook registration
# also builds its callback URL from it, so it must be reachable from the internet in production.
PUBLIC_BASE_URL=http://localhost:5180
BACKFILL_MONTHS=24
# Proxy hops in front of the API (client IPs for rate limits). 0 in dev; 1 in production behind the web server.
TRUST_PROXY=0
