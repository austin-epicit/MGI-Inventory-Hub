{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"outDir": "./dist",
		"rootDir": "./",
		"esModuleInterop": true,
		"strict": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": ["node"]
	},
	"include": ["*.ts", "src/**/*.ts", "test/**/*.ts", "prisma/**/*.ts", "fixtures/**/*.ts"],
	"exclude": ["generated/**", "dist/**"]
}
