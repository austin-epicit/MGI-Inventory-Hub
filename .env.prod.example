# Copy to .env.prod (gitignored) and fill in. Used with:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
# One-time deploy config only; everything operational (admin, users, Cin7 key, sync) is in the app.
# Values must not contain spaces, quotes, or `$`.

# Public host name that points at this server, no scheme. Caddy gets the HTTPS certificate for it.
DOMAIN=
# https:// plus DOMAIN. Same-origin checks use its host, and Cin7 webhooks call back to it,
# so it must be reachable from the internet.
PUBLIC_BASE_URL=

# Database password. Goes into a connection URL, so use letters and digits only.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=
# Signs session cookies, 16+ chars. Changing it logs everyone out.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# AES-256-GCM key for the stored Cin7 credentials: exactly 32 bytes, base64. Back it up outside
# the server: losing it means re-entering the Cin7 credentials (and re-registering webhooks).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Authorizes creating the first admin on /setup (8+ chars). Not needed after that.
SETUP_TOKEN=

# Optional (defaults shown).
# APP_TIMEZONE=America/Los_Angeles
# SESSION_TTL_HOURS=12
# BACKFILL_MONTHS=24
# Hour (UTC, 0-23) the daily backup runs.
# BACKUP_HOUR_UTC=3
